# Local development fallback for secrets.
# Prefer macOS Keychain: service=client-outreach, account=<NAME>

# Neon PostgreSQL (required). Use the pooled connection string on Vercel.
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Auth (Better Auth). Generate the secret with: openssl rand -base64 32
# BETTER_AUTH_URL is the public origin, e.g. https://optra.example.com
# (on Vercel it falls back to the production domain when unset).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
# "Continue with Google" reuses GOOGLE_OAUTH_CLIENT_ID / SECRET below.
# Add this redirect URI to that OAuth client:
#   http://127.0.0.1:3000/api/auth/callback/google (and the production equivalent)

# Public research model (Gemini)
GOOGLE_API_KEY=

# Private writing model (Claude)
ANTHROPIC_API_KEY=

# Phase 3 — mailbox (prefer Admin → Connect mailbox)
# Gmail OAuth (one-time Google Cloud OAuth client — Web application)
# Redirect URI: http://127.0.0.1:3000/api/mail/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Filled by Connect Gmail / Other email UI — usually leave blank here:
# MAIL_AUTH_MODE=
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_OAUTH_REFRESH_TOKEN=
# MAIL_PROVIDER=
# MAIL_SMTP_HOST=
# MAIL_IMAP_HOST=

# Job collection — optional Apify fallback (≤ $0.50/day).
# LinkedIn, HelloWorld and Infostud are read directly from public pages; without a
# token everything still works. With a token, Apify is used only when LinkedIn's
# guest pages block us (429 / auth wall) or when the explicit `apify` ATS source is on.
APIFY_TOKEN=
# ATS boards via Apify (only with the explicit `apify` source)
APIFY_ACTOR_GENERIC=fetch_cat/ats-jobs-scraper
# LinkedIn fallback actor (built-in default if unset)
APIFY_ACTOR_LINKEDIN=mfrostbutter/linkedin-jobs-scraper
# No longer used by the collector (direct adapters); kept for manual actor runs
APIFY_ACTOR_HELLOWORLD=unfenced-group/helloworld-rs-scraper
APIFY_ACTOR_INFOSTUD=unfenced-group/poslovi-infostud-scraper
# Optional per-ATS overrides:
# APIFY_ACTOR_GREENHOUSE=
# APIFY_ACTOR_LEVER=
# APIFY_ACTOR_ASHBY=

# Optional — GitHub profile import (higher rate limits for public API)
# GITHUB_TOKEN=

# Optional model overrides
# PUBLIC_LLM_MODEL=gemini-3.1-flash-lite
# Profile/CV extract when ANTHROPIC_API_KEY is empty (PII-redacted).
# PUBLIC_PROFILE_MODEL=gemini-flash-latest
# PRIVATE_WRITING_MODEL=claude-sonnet-4-5
# PRIVATE_CLASSIFY_MODEL=claude-haiku-4-5

# LOG_LEVEL=info
# COOKIE_SECURE=1
