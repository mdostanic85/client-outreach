# Local development fallback for secrets.
# Prefer macOS Keychain: service=client-outreach, account=<NAME>

# Neon PostgreSQL (required). Use the pooled connection string on Vercel.
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Public research model (Gemini)
GOOGLE_API_KEY=

# Private writing model (Claude)
ANTHROPIC_API_KEY=

# Phase 3 — Gmail app password (never store in the database)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Job collection — Apify ($0.50/day mix)
APIFY_TOKEN=
# ATS boards (Greenhouse / Lever / Ashby / …)
APIFY_ACTOR_GENERIC=fetch_cat/ats-jobs-scraper
# Coverage + regional (built-in defaults match these if unset)
APIFY_ACTOR_LINKEDIN=mfrostbutter/linkedin-jobs-scraper
APIFY_ACTOR_HELLOWORLD=unfenced-group/helloworld-rs-scraper
APIFY_ACTOR_INFOSTUD=unfenced-group/poslovi-infostud-scraper
# Optional per-ATS overrides:
# APIFY_ACTOR_GREENHOUSE=
# APIFY_ACTOR_LEVER=
# APIFY_ACTOR_ASHBY=

# Optional — GitHub profile import (higher rate limits for public API)
# GITHUB_TOKEN=

# Optional model overrides
# PUBLIC_LLM_MODEL=gemini-3.1-flash-lite
# PRIVATE_WRITING_MODEL=claude-sonnet-4-5
# PRIVATE_CLASSIFY_MODEL=claude-haiku-4-5

# LOG_LEVEL=info
# COOKIE_SECURE=1
